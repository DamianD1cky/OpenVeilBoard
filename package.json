{
  "name": "open-veilboard",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5188",
    "build": "npm run check && node scripts/build.mjs",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "check:browser": "node scripts/verify-browser.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 5188",
    "supabase:push:dry": "node scripts/supabase-push-management.mjs --dry-run",
    "supabase:push": "node scripts/supabase-push-management.mjs"
  },
  "dependencies": {
    "@dice-roller/rpg-dice-roller": "^5.5.1",
    "@supabase/supabase-js": "^2.118.0",
    "cannon-es": "0.20.0",
    "dompurify": "^3.3.0",
    "marked": "^17.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright-core": "^1.65.1",
    "prettier": "^3.10.1",
    "supabase": "^3.2.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=22"
  }
}
